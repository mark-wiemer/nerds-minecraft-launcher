{
  "build": {
    "beforeDevCommand": "pnpm turbo run dev --filter=@nml/app-frontend",
    "beforeBuildCommand": "pnpm turbo run build --filter=@nml/app-frontend",
    "frontendDist": "../app-frontend/dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "",
    "targets": ["appimage", "deb", "rpm"],
    "externalBin": [],
    "icon": ["icons/128x128.png", "icons/128x128@2x.png"],
    "longDescription": "",
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "fileAssociations": [
      {
        "ext": ["mrpack"],
        "mimeType": "application/zip+mrpack"
      }
    ]
  },
  "productName": "Nerd's Minecraft Launcher",
  "version": "0.9.0",
  "mainBinaryName": "Nerd's Minecraft Launcher",
  "identifier": "NMLApp",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nml"]
      },
      "mobile": []
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Nerd's Minecraft Launcher",
        "width": 1280,
        "minHeight": 700,
        "minWidth": 1100,
        "visible": true,
        "zoomHotkeysEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": ["$APPDATA/caches/icons/*", "$APPCONFIG/caches/icons/*", "$CONFIG/caches/icons/*"],
        "enable": true
      },
      "capabilities": ["ads", "core", "plugins"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://modrinth.com https://*.modrinth.com https://*.posthog.com https://*.sentry.io https://api.mclo.gs",
        "font-src": ["https://cdn-raw.modrinth.com/fonts/inter/"],
        "img-src": "https: 'unsafe-inline' 'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "https://*.posthog.com 'self'",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://discord.com 'self'"
      }
    }
  }
}
